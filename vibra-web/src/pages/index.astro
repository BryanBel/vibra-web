<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
  var PRODUCTS = {
    'mariposa':    { name:'Cadena de Mano Mariposa', phrase:'Dije de mariposa', material:'Acero dorado o plateado · ajustable', charm:'butterfly', color:'#7A1E2C' },
    'corazon':     { name:'Cadena de Mano Corazón', phrase:'Dije de corazón', material:'Acero plateado · ajustable', charm:'heart', color:'#7A1E2C' },
    'flor-dorada': { name:'Cadena de Mano Flor Dorada', phrase:'Dije de flor · esmalte con perla', material:'Acero dorado · dije esmaltado', charm:'flower', color:'#9E7A28' },
    'flor-plata':  { name:'Cadena de Mano Flor Plata', phrase:'Dije de flor · liso', material:'Acero plateado · dije esmaltado negro', charm:'flower', color:'#7A1E2C' }
  };
  var CHARM_SVG = {
    butterfly:'<path d="M80 58C68 44 46 40 40 54C34 68 56 78 80 58Z"/><path d="M80 58C92 44 114 40 120 54C126 68 104 78 80 58Z"/><path d="M80 46C74 52 74 68 80 80C86 68 86 52 80 46Z"/>',
    heart:'<path d="M48 66c8-16 24-24 32-24s24 8 32 24c-8 24-24 30-32 30s-24-6-32-30z"/>',
    flower:'<circle cx="80" cy="42" r="14"/><circle cx="80" cy="78" r="14"/><circle cx="62" cy="60" r="14"/><circle cx="98" cy="60" r="14"/><circle cx="80" cy="60" r="6" fill="currentColor" stroke="none"/>'
  };

  var menuToggle = document.getElementById('menuToggle');
  var mobilePanel = document.getElementById('mobilePanel');
  menuToggle.addEventListener('click', function(){
    var open = mobilePanel.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open);
  });
  mobilePanel.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mobilePanel.classList.remove('open'); menuToggle.setAttribute('aria-expanded', 'false'); });
  });

  var toastEl = document.getElementById('toast');
  var toastTimer;
  function toast(msg){
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 2400);
  }

  var lastFocused = null;
  function focusablesIn(container){
    return Array.prototype.slice.call(container.querySelectorAll(
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
    ));
  }
  function openDialog(container, focusTarget){
    lastFocused = document.activeElement;
    (focusTarget || focusablesIn(container)[0] || container).focus();
  }
  function closeDialog(){
    if(lastFocused){ lastFocused.focus(); lastFocused = null; }
  }
  function trapTab(container, e){
    if(e.key !== 'Tab') return;
    var focusables = focusablesIn(container);
    if(!focusables.length) return;
    var first = focusables[0], last = focusables[focusables.length - 1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  }

  var CART_KEY = 'vibra_cart_v1';
  var cart = [];
  try { cart = JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch(e){ cart = []; }

  var cartCountEl = document.getElementById('cartCount');
  var cartItemsEl = document.getElementById('cartItems');
  var drawerWhatsappBtn = document.getElementById('drawerWhatsappBtn');

  function saveCart(){
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    renderCart();
  }
  function renderCart(){
    var total = cart.reduce(function(n,i){ return n + i.qty; }, 0);
    cartCountEl.textContent = total;
    if(!cart.length){
      cartItemsEl.innerHTML = '<p class="cart-empty">Tu carrito está vacío — todavía.</p>';
      drawerWhatsappBtn.href = 'https://wa.me/584125589119';
      return;
    }
    cartItemsEl.innerHTML = cart.map(function(item){
      var p = PRODUCTS[item.id];
      return '<div class="cart-line"><div><div class="cl-name">'+p.name+'</div><div class="cl-meta">Cantidad: '+item.qty+'</div></div></div>';
    }).join('');
    var summary = cart.map(function(item){
      var p = PRODUCTS[item.id];
      return item.qty + 'x ' + p.name;
    }).join(', ');
    drawerWhatsappBtn.href = 'https://wa.me/584125589119?text=' + encodeURIComponent('Hola! Quiero consultar disponibilidad de: ' + summary);
  }
  function addToCart(id, qty){
    qty = qty || 1;
    var existing = cart.find(function(i){ return i.id === id; });
    if(existing){ existing.qty += qty; } else { cart.push({ id:id, qty:qty }); }
    saveCart();
    toast(PRODUCTS[id].name + ' agregado al carrito');
  }
  renderCart();

  document.querySelectorAll('[data-add-cart]').forEach(function(btn){
    btn.addEventListener('click', function(){ addToCart(btn.getAttribute('data-add-cart'), 1); });
  });

  var cartBtn = document.getElementById('cartBtn');
  var cartDrawer = document.getElementById('cartDrawer');
  var drawerOverlay = document.getElementById('drawerOverlay');
  function openDrawer(){ cartDrawer.classList.add('open'); drawerOverlay.classList.add('open'); openDialog(cartDrawer); }
  function closeDrawer(){
    if(!cartDrawer.classList.contains('open')) return;
    cartDrawer.classList.remove('open'); drawerOverlay.classList.remove('open'); closeDialog();
  }
  cartBtn.addEventListener('click', openDrawer);
  drawerOverlay.addEventListener('click', closeDrawer);
  document.getElementById('drawerClose').addEventListener('click', closeDrawer);

  var qvOverlay = document.getElementById('qvOverlay');
  var qvArt = document.getElementById('qvArt');
  var qvName = document.getElementById('qvName');
  var qvPhrase = document.getElementById('qvPhrase');
  var qvDesc = document.getElementById('qvDesc');
  var qvQty = document.getElementById('qvQty');
  var qvAdd = document.getElementById('qvAdd');
  var qvQtyVal = 1;
  var qvCurrentId = null;
  var qvWhatsapp = document.getElementById('qvWhatsapp');

  function openQuickview(id){
    var p = PRODUCTS[id];
    qvCurrentId = id;
    qvQtyVal = 1;
    qvQty.textContent = qvQtyVal;
    qvName.textContent = p.name;
    qvPhrase.textContent = p.phrase;
    qvDesc.textContent = p.material + '. Armado a mano en pequeños lotes — el tono puede variar levemente entre piezas.';
    qvWhatsapp.href = 'https://wa.me/584125589119?text=' + encodeURIComponent('Hola! Me interesa la ' + p.name + ', ¿está disponible?');
    qvArt.innerHTML = '<svg viewBox="0 0 160 170" width="60%" fill="none" stroke="'+p.color+'" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" style="color:'+p.color+'">'+CHARM_SVG[p.charm]+'<path d="M80 88v40" stroke-dasharray="1 8"/><circle cx="80" cy="132" r="3" fill="'+p.color+'"/><path d="M56 140a24 10 0 0 0 48 0"/></svg>';
    qvOverlay.classList.add('open');
    openDialog(qvOverlay.querySelector('.modal'), qvClose);
  }
  function closeQuickview(){
    if(!qvOverlay.classList.contains('open')) return;
    qvOverlay.classList.remove('open');
    closeDialog();
  }
  document.querySelectorAll('[data-open-quickview]').forEach(function(btn){
    btn.addEventListener('click', function(){ openQuickview(btn.getAttribute('data-open-quickview')); });
  });
  var qvClose = document.getElementById('qvClose');
  qvClose.addEventListener('click', closeQuickview);
  qvOverlay.addEventListener('click', function(e){ if(e.target === qvOverlay){ closeQuickview(); } });
  document.getElementById('qvMinus').addEventListener('click', function(){ qvQtyVal = Math.max(1, qvQtyVal-1); qvQty.textContent = qvQtyVal; });
  document.getElementById('qvPlus').addEventListener('click', function(){ qvQtyVal = Math.min(9, qvQtyVal+1); qvQty.textContent = qvQtyVal; });
  qvAdd.addEventListener('click', function(){
    addToCart(qvCurrentId, qvQtyVal);
    qvOverlay.classList.remove('open');
    openDrawer();
  });

  var nf = document.getElementById('newsletterForm');
  var nfMsg = document.getElementById('newsletterMsg');
  nf.addEventListener('submit', function(e){
    e.preventDefault();
    var email = document.getElementById('newsletterEmail').value.trim();
    var valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if(!valid){
      nfMsg.textContent = 'Ingresa un correo válido.';
      nfMsg.classList.add('error');
      return;
    }
    nfMsg.classList.remove('error');
    nfMsg.textContent = '¡Gracias por unirte a la comunidad VIBRA!';
    nf.reset();
  });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){
      if(qvOverlay.classList.contains('open')) closeQuickview();
      if(cartDrawer.classList.contains('open')) closeDrawer();
      return;
    }
    if(e.key === 'Tab'){
      if(qvOverlay.classList.contains('open')) trapTab(qvOverlay.querySelector('.modal'), e);
      else if(cartDrawer.classList.contains('open')) trapTab(cartDrawer, e);
    }
  });
})();
</script>
